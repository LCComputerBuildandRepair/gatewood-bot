# ─── Discord (required) ──────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=your-application-id
GUILD_ID=your-discord-server-id

# ─── Branding (optional) ─────────────────────────────────────────────────────
COMMUNITY_NAME=Gatewood RP
BRAND_COLOR=D4AF37
ACCENT_COLOR=2B6CB0
# Logo shown on every embed. Leave blank to use the bot's avatar
# (set that from assets/logo.png with: npm run avatar)
LOGO_URL=
# Shown on panels / /help
STORE_URL=
WEBSITE_URL=
CONNECT_URL=

# ─── FiveM server (optional — live status embed + bot presence) ──────────────
SERVER_QUERY_ENABLED=true
# Your FXServer IP:port (the txAdmin/server port, usually 30120)
SERVER_HOST=127.0.0.1
SERVER_PORT=30120
# cfx.re join code, e.g. abc123 from https://cfx.re/join/abc123 (optional)
CFX_CODE=
# Max slots shown in the status embed if the server doesn't report one
SERVER_MAX_SLOTS=64

# ─── In-game bridge (optional — two-way Discord <-> FiveM) ───────────────────
BRIDGE_ENABLED=false
BRIDGE_PORT=30122
# Must match Config.Secret in fivem-resource/gatewood_bridge/config.lua
BRIDGE_SECRET=change-this-to-a-long-random-string

# ─── Twitch go-live alerts (optional) ────────────────────────────────────────
# From https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Public status API (feeds the Gatewood website) ───────────────────────────
# Lets gatewoodrp.com show a live player count. Read-only and public by design:
# it returns only what the FiveM server already publishes (player count, slots,
# hostname, resource count). No write endpoints, no secrets, no identifiers.
# Open this port in your VPS firewall or the website cannot reach it.
STATUS_API_ENABLED=false
STATUS_API_PORT=30123
STATUS_API_HOST=0.0.0.0
# Lock it to your site only by putting your domain here instead of *
STATUS_API_ORIGIN=*
# Seconds' worth of caching, so the website can't hammer the game server
STATUS_API_CACHE_MS=15000
# Publish the live player NAME list on the website? Names are already visible
# in-game, but putting them on a public page is a separate choice.
STATUS_API_SHOW_PLAYERS=false
